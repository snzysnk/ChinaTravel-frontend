{
  "name": "chinatravel-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChinaTravel 前端：Vue 3 + TypeScript + Vite，作为「页面 -> 后端接口 -> 领域层」链路的消费端。",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
